	float n_out8p0;
// PerlinNoise2D:8
	vec3 n_in8p1 = vec3(0.00000, 0.00000, 0.00000);
	float n_in8p2 = 25.00000;
	vec3 n_in8p3 = vec3(25.00000, 25.00000, 0.00000);
	{
		n_out8p0 = _perlin2dNoiseFunc((vec3(n_out2p0, 0.0).xy+n_in8p1.xy)*n_in8p2, n_in8p3.xy);
	}


// Mix:11
	vec3 n_out11p0 = mix(vec3(n_out9p0.xyz), vec3(n_out10p0.xyz), vec3(n_out8p0));


// Reroute:38
	vec3 n_out38p0 = n_out11p0;


	float n_out3p0;
// PerlinNoise2D:3
	vec3 n_in3p1 = vec3(1.78500, 0.00000, 0.00000);
	float n_in3p2 = 10.00000;
	vec3 n_in3p3 = vec3(25.00000, 25.00000, 0.00000);
	{
		n_out3p0 = _perlin2dNoiseFunc((vec3(n_out2p0, 0.0).xy+n_in3p1.xy)*n_in3p2, n_in3p3.xy);
	}


// VectorDecompose:5
	float n_out5p0 = n_out2p0.x;
	float n_out5p1 = n_out2p0.y;


	float n_out6p0;
// Remap:6
	float n_in6p1 = 0.30000;
	float n_in6p2 = 1.00000;
	float n_in6p3 = 0.00000;
	float n_in6p4 = 1.00000;
	{
		float __input_range = n_in6p2 - n_in6p1;
		float __output_range = n_in6p4 - n_in6p3;
		n_out6p0 = n_in6p3 + __output_range * ((n_out5p1 - n_in6p1) / __input_range);
	}


// FloatOp:4
	float n_out4p0 = n_out3p0 * n_out6p0;


// Step:7
	float n_in7p0 = 0.15500;
	float n_out7p0 = step(n_in7p0, n_out4p0);


// Reroute:14
	float n_out14p0 = n_out7p0;


// Mix:39
	vec3 n_out39p0 = mix(n_out26p0, n_out38p0, vec3(n_out14p0));


// FloatConstant:29
	float n_out29p0 = 1.048000;


// Input:34
	vec2 n_out34p0 = UV;


	vec3 n_out32p0;
// RotateUV:32
	float n_in32p1 = 0.90500;
	vec3 n_in32p2 = vec3(0.50000, 0.50000, 0.00000);
	{
		n_out32p0 = _rotateUV(vec3(n_out34p0, 0.0), n_in32p2.xy, n_in32p1);
	}


	vec3 n_out33p0;
// ScaleUV:33
	vec3 n_in33p1 = vec3(3.00000, 20.00000, 0.00000);
	vec3 n_in33p2 = vec3(0.50000, 0.50000, 0.00000);
	{
		n_out33p0.xy = _scaleUV(n_out32p0.xy, n_in33p1.xy, n_in33p2.xy);
	}


	float n_out31p0;
// GenericNoise2D:31
	vec3 n_in31p1 = vec3(0.00000, 0.00000, 0.00000);
	float n_in31p2 = 5.00000;
	{
		n_out31p0 = _genericNoise2D((n_out33p0.xy + n_in31p1.xy) * n_in31p2);
	}


// FloatOp:35
	float n_out35p0 = n_out17p0 * n_out31p0;


// FloatOp:37
	float n_out37p0 = n_out29p0 * n_out35p0;


	float n_out46p0;
// Remap:46
	float n_in46p1 = 0.00000;
	float n_in46p2 = 1.00000;
	float n_in46p3 = 0.94500;
	float n_in46p4 = 1.00000;
	{
