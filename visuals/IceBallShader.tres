	float n_out17p0;
	float n_out17p1;
// Voronoi:17
	float n_in17p1 = 10.00000;
	float n_in17p2 = 2.00000;
	{
		n_out17p0 = voronoi_noise_euclidean(UV, n_in17p1, n_in17p2, n_out17p1);
	}


// Mix:23
	vec3 n_out23p0 = mix(vec3(n_out21p0.xyz), vec3(n_out22p0.xyz), vec3(n_out17p1));


// SmoothStep:27
	float n_in27p0 = 0.09000;
	float n_in27p1 = 0.89000;
	float n_out27p0 = smoothstep(n_in27p0, n_in27p1, n_out17p0);


	float n_out28p0;
// Remap:28
	float n_in28p1 = 0.00000;
	float n_in28p2 = 1.00000;
	float n_in28p3 = 0.10000;
	float n_in28p4 = 1.00000;
	{
		float __input_range = n_in28p2 - n_in28p1;
		float __output_range = n_in28p4 - n_in28p3;
		n_out28p0 = n_in28p3 + __output_range * ((n_out27p0 - n_in28p1) / __input_range);
	}


// VectorOp:26
	vec3 n_out26p0 = n_out23p0 * vec3(n_out28p0);


// ColorConstant:9
	vec4 n_out9p0 = vec4(0.306800, 0.585280, 0.590000, 1.000000);


// ColorConstant:10
	vec4 n_out10p0 = vec4(0.780000, 0.996333, 1.000000, 1.000000);


// Input:2
