		float __output_range = n_in46p4 - n_in46p3;
		n_out46p0 = n_in46p3 + __output_range * ((n_out37p0 - n_in46p1) / __input_range);
	}


// Mix:45
	float n_in45p1 = 1.00000;
	float n_out45p0 = mix(n_out46p0, n_in45p1, n_out14p0);


// FloatConstant:41
	float n_out41p0 = 0.900000;


// Mix:40
	float n_out40p0 = mix(n_out37p0, n_out41p0, n_out14p0);


// FloatConstant:36
	float n_out36p0 = 1.000000;


// FloatConstant:44
	float n_out44p0 = 0.800000;


// Mix:43
	float n_out43p0 = mix(n_out36p0, n_out44p0, n_out14p0);


// Input:18
	vec3 n_out18p0 = NORMAL;


	float n_out19p0;
// Remap:19
	float n_in19p1 = 0.00000;
	float n_in19p2 = 1.00000;
	float n_in19p3 = -0.20000;
	float n_in19p4 = 0.20000;
	{
		float __input_range = n_in19p2 - n_in19p1;
		float __output_range = n_in19p4 - n_in19p3;
		n_out19p0 = n_in19p3 + __output_range * ((n_out17p1 - n_in19p1) / __input_range);
	}


// VectorOp:20
	vec3 n_out20p0 = n_out18p0 + vec3(n_out19p0);


// Mix:42
	vec3 n_out42p0 = mix(n_out20p0, n_out18p0, vec3(n_out14p0));


// Output:0
	ALBEDO = n_out39p0;
	ALPHA = n_out45p0;
	ROUGHNESS = n_out40p0;
	SPECULAR = n_out43p0;
	NORMAL = n_out42p0;


}
