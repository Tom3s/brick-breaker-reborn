void fragment() {
// Input:3
	vec4 n_out3p0 = COLOR;


// FloatParameter:5
	float n_out5p0 = Scale;


// VectorDecompose:4
	float n_out4p0 = vec3(n_out3p0.xyz).x;
	float n_out4p1 = vec3(n_out3p0.xyz).y;
	float n_out4p2 = vec3(n_out3p0.xyz).z;


// FloatOp:6
	float n_out6p0 = n_out5p0 * n_out4p2;


	float n_out2p0;
	float n_out2p1;
// WorleyNoise3D:2
	vec3 n_in2p1 = vec3(0.00000, 0.00000, 0.00000);
	float n_in2p3 = 1.00000;
	{
		vec2 n_out2p0n_out2p1 = _cellular3dNoiseFunc(vec3((vec3(n_out3p0.xyz).xy+n_in2p1.xy)*n_out5p0, n_out6p0), min(max(n_in2p3, 0.0), 1.0));
		n_out2p0 = n_out2p0n_out2p1.x;
		n_out2p1 = n_out2p0n_out2p1.y;
	}


// Output:0
	ALBEDO = vec3(n_out2p0);


}
