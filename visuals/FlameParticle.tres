code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;




void vertex() {
	mat4 n_out2p0;
// GetBillboardMatrix:2
	{
		mat4 __mvm = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0], INV_VIEW_MATRIX[1], INV_VIEW_MATRIX[2], MODEL_MATRIX[3]);
		__mvm = __mvm * mat4(vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0), vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0), vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0), vec4(0.0, 0.0, 0.0, 1.0));
		n_out2p0 = __mvm;
	}


// Output:0
	MODELVIEW_MATRIX = n_out2p0;


}

void fragment() {
// ColorConstant:11
	vec4 n_out11p0 = vec4(1.000000, 1.000000, 1.000000, 1.000000);


// ColorConstant:8
	vec4 n_out8p0 = vec4(1.000000, 0.000000, 0.000000, 1.000000);


// ColorConstant:9
	vec4 n_out9p0 = vec4(1.000000, 0.733333, 0.000000, 1.000000);


// Input:5
	vec2 n_out5p0 = UV;


// VectorOp:16
	vec2 n_in16p1 = vec2(0.00000, 2.00000);
	vec2 n_out16p0 = pow(n_out5p0, n_in16p1);


// Mix:10
	vec3 n_out10p0 = mix(vec3(n_out8p0.xyz), vec3(n_out9p0.xyz), vec3(n_out16p0, 0.0));


// Distance:4
	vec2 n_in4p1 = vec2(0.50000, 0.50000);
	float n_out4p0 = distance(n_out5p0, n_in4p1);


// SmoothStep:15
	float n_in15p0 = 0.10000;
	float n_in15p1 = 0.40000;
	float n_out15p0 = smoothstep(n_in15p0, n_in15p1, n_out4p0);


// Mix:13
	vec3 n_out13p0 = mix(vec3(n_out11p0.xyz), n_out10p0, vec3(n_out15p0));


// Input:18
	vec4 n_out18p0 = COLOR;


// VectorOp:17
	vec3 n_out17p0 = n_out13p0 * vec3(n_out18p0.xyz);


// Step:6
	float n_in6p0 = 0.50000;
	float n_out6p0 = step(n_in6p0, n_out4p0);


// FloatFunc:7
	float n_out7p0 = 1.0 - n_out6p0;


// Output:0
	ALBEDO = n_out17p0;
	ALPHA = n_out7p0;


}
